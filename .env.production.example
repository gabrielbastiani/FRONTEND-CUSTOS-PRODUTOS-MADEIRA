# Ambiente de produção do Wood Pricing no servidor aaPanel.
# A API Node.js atende na porta 7001 e o frontend Next.js na porta 7002.
NEXT_PUBLIC_API_URL=http://192.168.0.208:7001/api/v1
NEXT_PUBLIC_FILES_URL=http://192.168.0.208:7001

# Porta usada pelo frontend. O validador impede que a API/arquivos apontem para ela.
FRONTEND_PORT=7002
